rules_version = '2';

// Regole pensate per un party game casual tra amici: il codice a 6 cifre
// è il confine pratico di accesso (chi ha il codice può leggere la lobby),
// non un vero segreto — vedi CLAUDE.md "Limiti noti dell'MVP". La parte
// realmente protetta è "solo il proprietario scrive i propri dati" e "solo
// l'host scrive lo stato di round", che RICHIEDONO l'auth anonima
// (request.auth.uid) per essere applicabili.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHost(code) {
      return isSignedIn()
        && request.auth.uid == get(/databases/$(database)/documents/lobbies/$(code)).data.hostId;
    }

    match /lobbies/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'lobby'
        && request.resource.data.mode in ['online', 'offline']
        // matchMode è opzionale nella richiesta (client vecchi/con cache
        // stale potrebbero non mandarlo): se presente deve essere valido,
        // ma la sua assenza non deve bloccare la creazione della lobby con
        // un permission-denied duro — il client lo interpreta comunque
        // come 'standard' di default (vedi classifico/index.js).
        && (!('matchMode' in request.resource.data) || request.resource.data.matchMode in ['standard', 'custom'])
        && request.resource.data.currentGameId in ['classifico', 'chilhascritto']
        && request.resource.data.keys().hasOnly(['code', 'mode', 'matchMode', 'hostId', 'status', 'currentGameId', 'createdAt']);

      // Solo l'host può aggiornare la lobby, e solo i campi status/currentGameId
      // (code, hostId, createdAt restano immutabili dopo la creazione).
      allow update: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentGameId'])
        && request.resource.data.status in ['lobby', 'playing', 'finished'];

      allow delete: if false;

      match /players/{playerId} {
        allow read: if isSignedIn();

        // Ogni giocatore scrive SOLO il proprio documento.
        allow create, update: if isSignedIn()
          && request.auth.uid == playerId
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 18
          && request.resource.data.color is string;

        allow delete: if false;
      }

      match /rounds/current {
        allow read: if isSignedIn();
        // Solo l'host scrive lo stato di round (matchState): è la fonte
        // di verità autoritativa condivisa con tutti i client.
        allow write: if isHost(code);

        match /actions/{playerId} {
          // L'azione grezza (es. la classifica votata) la scrive solo il
          // proprietario; la legge solo il proprietario o l'host — nessun
          // altro giocatore deve poter sbirciare i voti altrui prima del
          // calcolo dei risultati.
          allow create, update: if isSignedIn() && request.auth.uid == playerId;
          allow read: if isSignedIn() && (request.auth.uid == playerId || isHost(code));
          allow delete: if false;
        }
      }

      // Segnalazione WebRTC (solo modalità offline): visibile solo
      // all'ospite interessato e all'host.
      match /signaling/{guestId} {
        allow read, write: if isSignedIn() && (request.auth.uid == guestId || isHost(code));

        match /{candidatesCollection}/{docId} {
          allow read, write: if isSignedIn() && (request.auth.uid == guestId || isHost(code));
        }
      }
    }
  }
}
